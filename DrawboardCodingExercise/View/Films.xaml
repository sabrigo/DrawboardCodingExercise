<Page
    x:Class="DrawboardCodingExercise.View.Films"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DrawboardCodingExercise.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valueConverters="using:DrawboardCodingExercise.ValueConverters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16"
                Padding="12"
                BorderBrush="{StaticResource TextBlockErrorBrush}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <FontIcon FontFamily="Segoe MDL2 Assets"
                          Glyph="&#xE7BA;"
                          FontSize="16"
                          VerticalAlignment="Top"
                          Margin="0,2,12,0"
                          Foreground="{StaticResource TextBlockErrorBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}"
                           d:Text="We couldn't load the films." />
            </StackPanel>
        </Border>

        <ListView Grid.Row="1"
                  x:Name="FilmsList"
                  ItemsSource="{Binding Films}"
                  IsItemClickEnabled="True"
                  ItemClick="FilmsList_OnItemClick"
                  SelectionMode="None"
                  Padding="0,0,4,16">
            <ListView.Resources>
                <!-- ponytail: square hover highlight traded away so the rounded cards stay clean;
                     the chevron carries the "clickable" affordance -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="64"
                                    Height="64"
                                    CornerRadius="8"
                                    Margin="0,0,16,0"
                                    Background="{StaticResource AccentBadgeBrush}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="EpisodeLabel"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               CharacterSpacing="80"
                                               TextTrimming="Clip"
                                               Foreground="{StaticResource OnAccentBadgeBrush}"
                                               d:Text="Episode" />
                                    <TextBlock Text="{Binding EpisodeId}"
                                               HorizontalAlignment="Center"
                                               FontSize="26"
                                               LineHeight="30"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OnAccentBadgeBrush}"
                                               d:Text="4" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource SubtitleTextBlockStyle}"
                                           d:Text="A New Hope" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Director}"
                                               Style="{StaticResource FieldLabelStyle}"
                                               d:Text="George Lucas" />
                                    <TextBlock Text="&#x2022;" Margin="8,0" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding ReleaseDate.Year}"
                                               Style="{StaticResource FieldLabelStyle}"
                                               d:Text="1977" />
                                </StackPanel>
                            </StackPanel>

                            <FontIcon Grid.Column="2"
                                      FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE76C;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
