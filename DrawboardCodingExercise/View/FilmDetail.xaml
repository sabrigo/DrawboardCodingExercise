<Page
    x:Class="DrawboardCodingExercise.View.FilmDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DrawboardCodingExercise.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:valueConverters="using:DrawboardCodingExercise.ValueConverters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}"
                    AutomationProperties.AutomationId="FilmDetailErrorBanner"
                    Margin="0,0,0,16"
                    Padding="12"
                    BorderBrush="{StaticResource TextBlockErrorBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              Glyph="&#xE7BA;"
                              FontSize="16"
                              VerticalAlignment="Top"
                              Margin="0,2,12,0"
                              Foreground="{StaticResource TextBlockErrorBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               AutomationProperties.AutomationId="FilmDetailErrorMessage"
                               Text="{Binding ErrorMessage}"
                               d:Text="We could not load the characters." />
                </StackPanel>
            </Border>

            <!-- Hero -->
            <StackPanel Orientation="Horizontal">
                <Border Width="72"
                        Height="72"
                        CornerRadius="8"
                        Background="{StaticResource AccentBadgeBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="EpisodeLabel"
                                   HorizontalAlignment="Center"
                                   FontSize="10"
                                   CharacterSpacing="80"
                                   TextTrimming="Clip"
                                   Foreground="{StaticResource OnAccentBadgeBrush}"
                                   d:Text="Episode" />
                        <TextBlock Text="{Binding Film.EpisodeId}"
                                   AutomationProperties.AutomationId="FilmDetailEpisode"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   LineHeight="34"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OnAccentBadgeBrush}"
                                   d:Text="4" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Film.Title}"
                           AutomationProperties.AutomationId="FilmDetailTitle"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           d:Text="A New Hope" />
            </StackPanel>

            <!-- Facts -->
            <Grid Margin="0,24,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="ReleaseDateLabel" Style="{StaticResource FieldLabelStyle}" d:Text="Release date" />
                        <TextBlock AutomationProperties.AutomationId="FilmDetailReleaseDate" Text="{Binding ReleaseDate}" Style="{StaticResource FieldValueStyle}" d:Text="25 May 1977" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="DirectorLabel" Style="{StaticResource FieldLabelStyle}" d:Text="Director" />
                        <TextBlock AutomationProperties.AutomationId="FilmDetailDirector" Text="{Binding Film.Director}" Style="{StaticResource FieldValueStyle}" d:Text="George Lucas" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Uid="ProducerLabel" Style="{StaticResource FieldLabelStyle}" d:Text="Producer" />
                        <TextBlock AutomationProperties.AutomationId="FilmDetailProducer" Text="{Binding Film.Producer}" Style="{StaticResource FieldValueStyle}" d:Text="Gary Kurtz, Rick McCallum" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Opening crawl -->
            <TextBlock x:Uid="OpeningCrawlHeader" Style="{StaticResource SectionHeaderStyle}" d:Text="Opening crawl" />            
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Left"
                    CornerRadius="0,8,8,0"
                    BorderThickness="4,0,0,0"
                    BorderBrush="{StaticResource AccentBadgeBrush}">
                <TextBlock Text="{Binding Film.OpeningCrawl}"
                           AutomationProperties.AutomationId="FilmDetailOpeningCrawl"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           FontSize="15"
                           LineHeight="24"
                           d:Text="It is a period of civil war..." />
            </Border>

            <!-- Characters -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Uid="CharactersHeader" Style="{StaticResource SectionHeaderStyle}" d:Text="Characters" />
                <Border Margin="8,28,0,10"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Padding="8,2"
                        Background="{ThemeResource SystemControlBackgroundListLowBrush}">
                    <TextBlock AutomationProperties.AutomationId="FilmDetailCharacterCount" Text="{Binding Characters.Count}" Style="{StaticResource FieldLabelStyle}" d:Text="18" />
                </Border>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Characters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="212" ItemHeight="40" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8"
                                CornerRadius="16"
                                Padding="12,6"
                                Background="{ThemeResource SystemControlBackgroundListLowBrush}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets"
                                          Glyph="&#xE77B;"
                                          FontSize="14"
                                          Margin="0,0,8,0"
                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding}"
                                           AutomationProperties.AutomationId="FilmDetailCharacterName"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding}"
                                           d:Text="Luke Skywalker" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
