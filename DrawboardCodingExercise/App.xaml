<Application
    x:Class="DrawboardCodingExercise.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="TextBlockErrorBrush">OrangeRed</SolidColorBrush>

        <!-- Star Wars crawl yellow; dark text sits on top of it in both themes -->
        <SolidColorBrush x:Key="AccentBadgeBrush" Color="#FFE81F" />
        <SolidColorBrush x:Key="OnAccentBadgeBrush" Color="#FF1B1B1B" />

        <!-- ponytail: no BasedOn on the built-in text styles - they are not in scope
             from Application.Resources and the app crashes on launch. Values match
             the Caption/Body/Subtitle metrics. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,10" />
        </Style>
    </Application.Resources>
</Application>
